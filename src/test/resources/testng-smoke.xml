<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng-smoke.xml — fast smoke suite
  Triggered by Jenkins on EVERY commit (should finish in under 10 minutes)
  Only includes critical path tests
-->
<suite name="Smoke Suite" verbose="1">

    <listeners>
        <listener class-name="com.project.listeners.TestListener"/>
    </listeners>

    <test name="Login Smoke Tests">
        <classes>
            <class name="com.project.smoke.LoginSmokeTest"/>
        </classes>
    </test>

</suite>
